# Ignore directories
Makefile
qdevelop-settings.db
qrc_mytetra.cpp
/app/qtc-gdbmacros
.qtc_clangd

/misc

*.pro.user
*.pro.user.*
*.autosave

/app/build
/app/build/*

/app/debug
/app/debug/*

/app/bin/*
!/app/bin/resource
!/app/bin/resource/*
!/app/bin/mytetra.qrc
!/app/bin/icons.qrc
!/app/bin/themes.qrc

/thirdParty/mimetex/build/bin/*

build-*-Debug/*
build-*-Release/*

# Ignore compiled Object files
*.slo
*.lo
*.o

# Ignore compiled Dynamic libraries
*.so

# Ignore compiled Static libraries
*.lai
*.la
*.a

# Ignore bash files
*.sh
!app/tests/*.sh
!build_portable_windows_*.sh

# Compiled Qt translations: built from .ts by lrelease on every build,
# never commit them (200KB churn on each translation fix)
app/bin/resource/translations/*.qm

# Ignore php tech files
/app/src/*.php

# Ignore IDE files
*.Debug
*.Release

#Ignore Qt resource autogenerated files
qrc_*.cpp

# Ignore gitignore self
# .gitignore

.qmake.stash

/app/ui_*
/app/user*appdatalocal*

flamegraph.svg
