#!/bin/bash
# Портабельная сборка MyTetra для Linux: каталог со всем нужным
# (бинари, Qt-либы, плагины, seed конфига, ланчер).
# Без расширения .sh специально: *.sh занесен в .gitignore,
# как и соседний script/start/mytetra.run
#
# Использование:
#   script/tools/make-portable <каталог со сборкой> <выходной каталог> [опции]
#
# Каталог со сборкой это app/bin после qmake+make (там mytetra и mimetex).
# Опции:
#   --qt <dir>    корень Qt (по умолчанию $Q или qmake из PATH)
#   --strip       вырезать отладочные символы (по умолчанию да)
#   --no-strip    не вырезать
#   --smoke       тестовый запуск собранного портабла в offscreen
#
# Пример:
#   Q=/media/user/m2data/Qt_deb11/5.15.2/gcc_64
#   script/tools/make-portable /tmp/mt-build/app/bin /tmp/mytetra-portable --smoke

set -u

BUILD_BIN=""
OUT_DIR=""
QT_DIR="${Q:-}"
DO_STRIP=1
DO_SMOKE=0

while [ $# -gt 0 ]; do
    case "$1" in
        --qt) QT_DIR="$2"; shift 2;;
        --strip) DO_STRIP=1; shift;;
        --no-strip) DO_STRIP=0; shift;;
        --smoke) DO_SMOKE=1; shift;;
        -h|--help)
            sed -n '2,20p' "$0"
            exit 0;;
        *)
            if [ -z "$BUILD_BIN" ]; then BUILD_BIN="$1";
            elif [ -z "$OUT_DIR" ]; then OUT_DIR="$1";
            else echo "Лишний аргумент: $1" >&2; exit 1; fi
            shift;;
    esac
done

if [ -z "$BUILD_BIN" ] || [ -z "$OUT_DIR" ]; then
    echo "Нужно: make-portable <каталог со сборкой> <выходной каталог>" >&2
    exit 1
fi

if [ -z "$QT_DIR" ] && command -v qmake >/dev/null 2>&1; then
    QT_DIR="$(qmake -query QT_INSTALL_PREFIX)"
fi

if [ -z "$QT_DIR" ] || [ ! -d "$QT_DIR" ]; then
    echo "Не найден Qt: задайте --qt <dir> или переменную Q" >&2
    exit 1
fi

if [ ! -x "$BUILD_BIN/mytetra" ]; then
    echo "Нет бинарника: $BUILD_BIN/mytetra (сначала qmake+make)" >&2
    exit 1
fi

# Корень исходников считается от места скрипта: script/tools/xxx
SRCROOT="$(dirname "$(readlink -e "$0")")/../.."

echo "== Портабл MyTetra: $BUILD_BIN -> $OUT_DIR (Qt $QT_DIR)"

rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR/lib" "$OUT_DIR/platforms" "$OUT_DIR/imageformats" \
         "$OUT_DIR/iconengines" "$OUT_DIR/xcbglintegrations" "$OUT_DIR/translations"

# Бинари
cp "$BUILD_BIN/mytetra" "$BUILD_BIN/mimetex" "$OUT_DIR/"
if [ "$DO_STRIP" -eq 1 ] && command -v strip >/dev/null 2>&1; then
    strip "$OUT_DIR/mytetra" "$OUT_DIR/mimetex"
fi

# Транзитивные зависимости: ldd бинарей и плагинов, забираются файлы
# из Qt (и ICU рядом с ним). Системные (/lib, /usr/lib) пропускаются:
# они есть в любом дистрибутиве. libssl подбирается отдельно ниже.
# Важно: ldd запускается с LD_LIBRARY_PATH на Qt, иначе зависимости
# плагинов резолвятся в системный Qt другой версии, смешивание версий
# роняет программу на старте (проверено на qsvg)
collect_deps() {
    LD_LIBRARY_PATH="$QT_DIR/lib:${LD_LIBRARY_PATH:-}" ldd "$1" 2>/dev/null | grep "=>" | awk '{print $3}' | grep -v "^$" | sort -u
}

copy_qt_lib() {
    local src="$1"
    local base
    base="$(basename "$src")"
    if [ ! -f "$OUT_DIR/lib/$base" ]; then
        cp -L "$src" "$OUT_DIR/lib/"
    fi
}

NEED="$BUILD_BIN/mytetra $BUILD_BIN/mimetex"
for plugin_dir in platforms imageformats iconengines xcbglintegrations; do
    if [ -d "$QT_DIR/plugins/$plugin_dir" ]; then
        cp "$QT_DIR/plugins/$plugin_dir/"*.so "$OUT_DIR/$plugin_dir/" 2>/dev/null || true
        for plugin in "$OUT_DIR/$plugin_dir/"*.so; do
            [ -f "$plugin" ] && NEED="$NEED $plugin"
        done
    fi
done

for target in $NEED; do
    for dep in $(collect_deps "$target"); do
        case "$dep" in
            "$QT_DIR"/lib/*) copy_qt_lib "$dep";;
        esac
    done
done

# Второй проход: зависимости самих скопированных либ (icu и прочие)
for lib in "$OUT_DIR/lib/"*.so*; do
    [ -f "$lib" ] || continue
    for dep in $(collect_deps "$lib"); do
        case "$dep" in
            "$QT_DIR"/lib/*) copy_qt_lib "$dep";;
        esac
    done
done

# OpenSSL 1.1 для Qt 5.15: Qt грузит его через dlopen, в ldd его нет.
# Копируется если нашелся рядом с Qt или в системе, иначе предупреждение:
# https-качалки на такой машине молча не заработают (см. AGENTS.md)
for sslname in libssl.so.1.1 libcrypto.so.1.1; do
    if [ ! -f "$OUT_DIR/lib/$sslname" ]; then
        for cand in "$QT_DIR/lib/$sslname" "/usr/lib/x86_64-linux-gnu/$sslname" "/lib/x86_64-linux-gnu/$sslname" "/usr/lib/$sslname"; do
            if [ -f "$cand" ]; then
                cp -L "$cand" "$OUT_DIR/lib/"
                break
            fi
        done
    fi
done
if [ ! -f "$OUT_DIR/lib/libssl.so.1.1" ]; then
    echo "!! libssl.so.1.1 не найден: https в портабле работать не будет" >&2
fi

# Переводы Qt для стандартных диалогов
cp "$QT_DIR/translations/qt_"*.qm "$OUT_DIR/translations/" 2>/dev/null || true
cp "$QT_DIR/translations/qtbase_"*.qm "$OUT_DIR/translations/" 2>/dev/null || true

# Seed конфига: conf.ini рядом с бинарником включает портативный режим
# (пути ./data и ./trash относительные). База и корзина создадутся
# сами при первом запуске из встроенных ресурсов
cp "$SRCROOT/app/bin/resource/standartconfig/any/conf.ini" "$OUT_DIR/"
cp "$SRCROOT/app/bin/resource/standartconfig/any/editorconf.ini" "$OUT_DIR/"

# Ланчер: LD_LIBRARY_PATH на lib, плагины рядом. Аргументы пробрасываются:
# это нужно в том числе для mytetra --control (хоткей клиппера из ОС)
cat > "$OUT_DIR/mytetra-portable" <<'LAUNCHER'
#!/bin/sh
PROGDIR=$(dirname $(readlink -e $0))
export LD_LIBRARY_PATH=$PROGDIR/lib:${LD_LIBRARY_PATH}
export QT_QPA_PLATFORM_PLUGIN_PATH=$PROGDIR/platforms
exec "$PROGDIR/mytetra" "$@"
LAUNCHER
chmod +x "$OUT_DIR/mytetra-portable"

cat > "$OUT_DIR/PORTABLE.txt" <<'INFO'
MyTetra portable для Linux
==========================
Запуск: ./mytetra-portable

Файл conf.ini рядом с программой включает портативный режим:
база (data/) и корзина (trash/) живут в этом каталоге.
Для переноса достаточно скопировать каталог целиком.

Глобальный хоткей клиппера (пример Ctrl+Q) вешается средствами
рабочего стола на команду:
  /путь/к/mytetra-portable --control --clipboard
MyTetra при этом должна быть запущена.
INFO

echo "== Готово: $(du -sh "$OUT_DIR" | cut -f1) в $OUT_DIR"
ls "$OUT_DIR"

# Проверка на смешивание версий Qt: ни одна забираемая либа не должна
# резолвиться в системный Qt. Иначе будет как с qsvg: падение на старте
MIXED=""
for target in "$OUT_DIR/mytetra" "$OUT_DIR"/platforms/*.so "$OUT_DIR"/imageformats/*.so "$OUT_DIR"/iconengines/*.so; do
    [ -f "$target" ] || continue
    BAD=$(LD_LIBRARY_PATH="$OUT_DIR/lib" ldd "$target" 2>/dev/null | grep "libQt5" | grep -v "$OUT_DIR/lib" | head -3)
    if [ -n "$BAD" ]; then
        echo "!! Смешивание Qt в $target:" >&2
        echo "$BAD" >&2
        MIXED=1
    fi
done
if [ -n "$MIXED" ]; then
    echo "!! Портабл тянет системный Qt, чинить зависимости" >&2
    exit 1
fi

# Дымовой тест: копия портабла во временный каталог с зерном базы,
# запуск в offscreen. Процесс должен жить (GUI без дисплея висит
# в event loop, падение было бы сразу)
if [ "$DO_SMOKE" -eq 1 ]; then
    echo "== Smoke test"
    SMOKE_DIR="$(mktemp -d)"
    cp -r "$OUT_DIR"/* "$SMOKE_DIR/"
    mkdir -p "$SMOKE_DIR/data/base/seed00000000000001"
    cp "$SRCROOT/app/bin/resource/standartdata/mytetra.xml" "$SMOKE_DIR/data/" 2>/dev/null || true
    cp "$SRCROOT/app/bin/resource/standartdata/database.ini" "$SMOKE_DIR/data/" 2>/dev/null || true
    cp "$SRCROOT/app/bin/resource/standartdata/base/1300000000aaaaaaaaa2/text.html" "$SMOKE_DIR/data/base/seed00000000000001/" 2>/dev/null || true
    ( cd "$SMOKE_DIR" && QT_QPA_PLATFORM=offscreen timeout 15 ./mytetra-portable >smoke.log 2>&1 ) &
    SMOKE_PID=$!
    sleep 12
    if kill -0 $SMOKE_PID 2>/dev/null; then
        echo "== Smoke OK: процесс жив"
        kill $SMOKE_PID 2>/dev/null || true
    else
        echo "!! Smoke FAIL: процесс умер, лог:" >&2
        tail -20 "$SMOKE_DIR/smoke.log" >&2
        rm -rf "$SMOKE_DIR"
        exit 1
    fi
    rm -rf "$SMOKE_DIR"
fi
